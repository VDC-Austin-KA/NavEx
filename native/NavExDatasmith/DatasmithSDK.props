<?xml version="1.0" encoding="utf-8"?>
<!--
  Where the built Datasmith SDK lives, and the compiler settings required to
  consume it.

  Building the `DatasmithSDK` program target from UE source populates:

      <Engine>\Binaries\Win64\DatasmithSDK\
          DatasmithSDK.dll  DatasmithSDK.lib  DatasmithSDK.pdb
          Public\   DatasmithCore + DirectLink + DatasmithExporter headers
          Private\  Core, CoreUObject, TraceLog, Messaging, AutoRTFM headers

  which is self-contained: the include paths point there, not into the engine
  source tree. Override DatasmithSDKPath on the command line to build against a
  different SDK:

      msbuild ... /p:DatasmithSDKPath=D:\other\DatasmithSDK\

  EVERY setting below is taken from the response file UBT itself used to build
  the SDK (Intermediate\Build\Win64\x64\DatasmithSDK\Development\Core\
  Core.Shared.rsp), not from Epic's "Setting Up your Project" page, which dates
  from UE4 and is missing most of it. Unreal's headers are configuration
  dependent (struct layout, alignment and inlining all change with these
  macros and switches), so a consumer built with a different set describes a
  different binary than the DLL it links against, and the failures are runtime
  corruption rather than link errors.
-->
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <DatasmithSDKPath Condition="'$(DatasmithSDKPath)' == ''">D:\UE58src\Engine\Binaries\Win64\DatasmithSDK\</DatasmithSDKPath>
  </PropertyGroup>

  <PropertyGroup>
    <BuildMacro_DatasmithSDKPath>$(DatasmithSDKPath)</BuildMacro_DatasmithSDKPath>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(DatasmithSDKPath)Public;$(DatasmithSDKPath)Private;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>

      <!--
        UBT force-includes its generated Definitions.h; UEDefinitions.h is that
        file with the *_API macros flipped to DLLIMPORT. See gen_defs.py.
      -->
      <ForcedIncludeFiles>UEDefinitions.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>

      <!-- The handful of defines UBT passes on the command line rather than in
           the generated header. -->
      <PreprocessorDefinitions>
        _WINDLL;
        _DISABLE_EXTENDED_ALIGNED_STORAGE;
        _HAS_EXCEPTIONS=0;
        PLATFORM_EXCEPTIONS_DISABLED=1;
        SAL_NO_ATTRIBUTE_DECLARATIONS=1;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>

      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <!-- /Zc:preprocessor. Unreal's macros need the conforming preprocessor;
           the traditional one mis-expands them. -->
      <UseStandardPreprocessor>true</UseStandardPreprocessor>
      <ExceptionHandling>false</ExceptionHandling>
      <FloatingPointModel>Precise</FloatingPointModel>
      <StructMemberAlignment>8Bytes</StructMemberAlignment>
      <!-- Unreal headers generate very large object files. -->
      <AdditionalOptions>/bigobj /Zc:inline /Zc:__cplusplus /Zc:strictStrings- %(AdditionalOptions)</AdditionalOptions>

      <!--
        /MD. The SDK is built against the DYNAMIC CRT (confirmed in UBT's own
        response file) in every configuration. Epic's sample .vcxproj says
        MultiThreaded, which is stale: mixing CRTs across this boundary is a
        runtime crash, not a link error, so this must not be "fixed" to /MT.
      -->
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(DatasmithSDKPath);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>DatasmithSDK.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
