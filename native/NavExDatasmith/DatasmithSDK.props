<?xml version="1.0" encoding="utf-8"?>
<!--
  Where the built Datasmith SDK lives, and the compiler/linker settings Epic
  requires to consume it. Same role as the DatasmithSDK.props that Epic's own
  DatasmithSDKSample.vcxproj imports.

  Building the `DatasmithSDK` program target from UE source populates:

      <Engine>\Binaries\Win64\DatasmithSDK\
          DatasmithSDK.dll  DatasmithSDK.lib  DatasmithSDK.pdb
          Public\   DatasmithCore + DirectLink + DatasmithExporter headers
          Private\  Core, CoreUObject, TraceLog, Messaging, AutoRTFM headers

  which is self-contained -- the include paths point there, not into the engine
  source tree. Override DatasmithSDKPath on the command line to build against a
  different SDK:

      msbuild ... /p:DatasmithSDKPath=D:\other\DatasmithSDK\
-->
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <DatasmithSDKPath Condition="'$(DatasmithSDKPath)' == ''">D:\UE58src\Engine\Binaries\Win64\DatasmithSDK\</DatasmithSDKPath>
  </PropertyGroup>

  <PropertyGroup>
    <BuildMacro_DatasmithSDKPath>$(DatasmithSDKPath)</BuildMacro_DatasmithSDKPath>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(DatasmithSDKPath)Public;$(DatasmithSDKPath)Private;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!--
        Epic's required set (Datasmith SDK Guidelines, "Setting Up your Project").
        The *_API=DLLIMPORT entries are what make the monolithic SDK DLL's symbols
        resolve; drop one and you get thousands of unresolved externals.
      -->
      <PreprocessorDefinitions>
        UE_BUILD_DEVELOPMENT=1;
        UE_BUILD_MINIMAL=1;
        WITH_EDITOR=0;
        WITH_EDITORONLY_DATA=1;
        WITH_SERVER_CODE=1;
        WITH_ENGINE=0;
        WITH_UNREAL_DEVELOPER_TOOLS=0;
        WITH_PLUGIN_SUPPORT=0;
        IS_MONOLITHIC=1;
        IS_PROGRAM=1;
        PLATFORM_WINDOWS=1;
        CORE_API=DLLIMPORT;
        COREUOBJECT_API=DLLIMPORT;
        DATASMITHEXPORTER_API=DLLIMPORT;
        DATASMITHCORE_API=DLLIMPORT;
        DIRECTLINK_API=DLLIMPORT;
        WIN32=1;
        _WIN32_WINNT=0x0601;
        WINVER=0x0601;
        UNICODE;
        _UNICODE;
        UE_BUILD_DEVELOPMENT_WITH_DEBUGGAME=0;
        UBT_COMPILED_PLATFORM=Windows;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <!-- Unreal requires C++20. -->
      <LanguageStandard>stdcpp20</LanguageStandard>
      <UseStandardPreprocessor>true</UseStandardPreprocessor>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(DatasmithSDKPath);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>DatasmithSDK.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
