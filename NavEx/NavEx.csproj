<?xml version="1.0" encoding="utf-8"?>
<!--
  Local development project: references the Navisworks assemblies from an
  installed copy of Navisworks Manage. Use NavEx.CI.csproj on machines without
  Navisworks installed.

  Build a specific year with:
      msbuild NavEx\NavEx.csproj /p:Configuration=Release-NW2027 /p:Platform=x64
-->
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{4C7A21E8-6F19-4B7D-9D2C-0B3E5A7C1D64}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>NavEx</RootNamespace>
    <AssemblyName>NavEx</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Per-year configurations, each pinned to one Navisworks install. -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release-NW2024|x64' ">
    <DebugType>pdbonly</DebugType><Optimize>true</Optimize>
    <OutputPath>bin\Release-NW2024\</OutputPath>
    <DefineConstants>TRACE;NW2024</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <NWPath>C:\Program Files\Autodesk\Navisworks Manage 2024\</NWPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release-NW2025|x64' ">
    <DebugType>pdbonly</DebugType><Optimize>true</Optimize>
    <OutputPath>bin\Release-NW2025\</OutputPath>
    <DefineConstants>TRACE;NW2025</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <NWPath>C:\Program Files\Autodesk\Navisworks Manage 2025\</NWPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release-NW2026|x64' ">
    <DebugType>pdbonly</DebugType><Optimize>true</Optimize>
    <OutputPath>bin\Release-NW2026\</OutputPath>
    <DefineConstants>TRACE;NW2026</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <NWPath>C:\Program Files\Autodesk\Navisworks Manage 2026\</NWPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release-NW2027|x64' ">
    <DebugType>pdbonly</DebugType><Optimize>true</Optimize>
    <OutputPath>bin\Release-NW2027\</OutputPath>
    <DefineConstants>TRACE;NW2027</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <NWPath>C:\Program Files\Autodesk\Navisworks Manage 2027\</NWPath>
  </PropertyGroup>

  <!-- Auto-detect the newest installed Navisworks when no year was pinned. -->
  <PropertyGroup Condition=" '$(NWPath)' == '' ">
    <NWPath Condition="Exists('C:\Program Files\Autodesk\Navisworks Manage 2027\Autodesk.Navisworks.Api.dll')">C:\Program Files\Autodesk\Navisworks Manage 2027\</NWPath>
    <NWPath Condition="'$(NWPath)' == '' AND Exists('C:\Program Files\Autodesk\Navisworks Manage 2026\Autodesk.Navisworks.Api.dll')">C:\Program Files\Autodesk\Navisworks Manage 2026\</NWPath>
    <NWPath Condition="'$(NWPath)' == '' AND Exists('C:\Program Files\Autodesk\Navisworks Manage 2025\Autodesk.Navisworks.Api.dll')">C:\Program Files\Autodesk\Navisworks Manage 2025\</NWPath>
    <NWPath Condition="'$(NWPath)' == '' AND Exists('C:\Program Files\Autodesk\Navisworks Manage 2024\Autodesk.Navisworks.Api.dll')">C:\Program Files\Autodesk\Navisworks Manage 2024\</NWPath>
    <NWPath Condition="'$(NWPath)' == ''">C:\Program Files\Autodesk\Navisworks Manage 2027\</NWPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />

    <!-- Private=False: these load from the running Navisworks, never from the plugin folder. -->
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NWPath)Autodesk.Navisworks.Api.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.ComApi">
      <HintPath>$(NWPath)Autodesk.Navisworks.ComApi.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Interop.ComApi">
      <HintPath>$(NWPath)Autodesk.Navisworks.Interop.ComApi.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="PluginMain.cs" />
    <Compile Include="MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Core\Vec.cs" />
    <Compile Include="Core\Log.cs" />
    <Compile Include="Core\ExportOptions.cs" />
    <Compile Include="Core\MaterialDef.cs" />
    <Compile Include="Core\MeshBuilder.cs" />
    <Compile Include="Core\PrimitiveCallback.cs" />
    <Compile Include="Core\GeometryExtractor.cs" />
    <Compile Include="Core\SelectionSetTree.cs" />
    <Compile Include="Core\PropertyExporter.cs" />
    <Compile Include="Core\SettingsStore.cs" />
    <Compile Include="Core\ExportRunner.cs" />
    <Compile Include="Core\Exporters\Json.cs" />
    <Compile Include="Core\Exporters\GltfWriter.cs" />
    <Compile Include="Core\Exporters\ObjWriter.cs" />
    <Compile Include="Core\Exporters\FbxWriter.cs" />
    <Compile Include="Core\Exporters\DatasmithWriter.cs" />
    <Compile Include="Core\FourD\SequenceModel.cs" />
    <Compile Include="Core\FourD\FourDName.cs" />
    <Compile Include="Core\FourD\ScheduleTask.cs" />
    <Compile Include="Core\FourD\ScheduleImporter.cs" />
    <Compile Include="Core\FourD\TaskMatcher.cs" />
    <Compile Include="Core\FourD\ScaleToTasks.cs" />
    <Compile Include="Core\FourD\TimelinerBridge.cs" />
    <Compile Include="Core\FourD\SetRenamer.cs" />
    <Compile Include="Core\FourD\FourDStore.cs" />
    <Compile Include="Controls\GanttView.cs" />
    <Compile Include="ColumnMappingWindow.cs" />
    <Compile Include="MainWindow.FourD.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Page Include="MainWindow.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <None Include="NavEx.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.WinFX.targets" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.WinFX.targets')" />
</Project>
