<Window x:Class="NavEx.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NavEx — Navisworks Geometry Exporter"
        Height="720" Width="1040"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F5F7"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FF1F6FEB"/>
        <SolidColorBrush x:Key="Panel" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Line" Color="#FFDDE1E6"/>
        <SolidColorBrush x:Key="Muted" Color="#FF6B7280"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="#FF111827"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="76"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FFB6C4DA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Foreground" Value="#FF374151"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#FF111827" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="NavEx" Foreground="White" FontSize="19" FontWeight="Bold"/>
                    <TextBlock x:Name="SubtitleText" Foreground="#FF9CA3AF" Margin="0,1,0,0"
                               Text="Export search sets and selections as GLB / glTF / OBJ"/>
                </StackPanel>
                <TextBlock x:Name="DocumentText" Grid.Column="1" Foreground="#FF9CA3AF"
                           VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Ready." Foreground="#FF374151"/>
                    <ProgressBar x:Name="Progress" Height="4" Margin="0,6,12,0" Minimum="0" Maximum="1"
                                 Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="EstimateButton" Content="Estimate" Click="OnEstimate"/>
                    <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" IsEnabled="False"/>
                    <Button x:Name="ExportButton" Content="Export" Style="{StaticResource PrimaryButton}" Click="OnExport"/>
                    <Button Content="Close" Click="OnClose"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Margin="12" Background="Transparent" BorderThickness="0">

            <!-- ── Export ─────────────────────────────────────────────── -->
            <TabItem Header="  Export  ">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                                       Text="What to export"/>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                                       Text="Tick the search sets or selection sets to export. Ticking a folder includes every set inside it. Each ticked set becomes its own file unless you switch to a single combined file."/>

                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Refresh" Click="OnRefreshTree"/>
                                <Button Content="Select all" Click="OnCheckAll"/>
                                <Button Content="Clear" Click="OnUncheckAll"/>
                                <Button Content="Expand" Click="OnExpandAll"/>
                                <Button Content="Collapse" Click="OnCollapseAll"/>
                            </StackPanel>

                            <TextBox DockPanel.Dock="Top" x:Name="FilterBox" Margin="0,0,0,8" Padding="4,3"
                                     TextChanged="OnFilterChanged"
                                     ToolTip="Type to filter sets by name"/>

                            <TreeView x:Name="SetTree" BorderThickness="1" BorderBrush="{StaticResource Line}">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Detail}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Muted}" FontSize="11"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Where it goes"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Output folder"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="OutputFolderBox" Padding="4,3" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" MinWidth="72"
                                                Click="OnBrowseFolder"/>
                                    </Grid>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Format"/>
                                    <ComboBox x:Name="FormatCombo" SelectionChanged="OnFormatChanged">
                                        <ComboBoxItem Content="GLB — single binary file (recommended)" Tag="Glb"/>
                                        <ComboBoxItem Content="glTF + .bin — JSON plus buffer" Tag="GltfSeparate"/>
                                        <ComboBoxItem Content="glTF embedded — JSON only, base64 buffer" Tag="GltfEmbedded"/>
                                        <ComboBoxItem Content="OBJ + MTL — legacy interchange" Tag="Obj"/>
                                    </ComboBox>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Batch behaviour"/>
                                    <ComboBox x:Name="BatchCombo">
                                        <ComboBoxItem Content="One file per set" Tag="FilePerSet"/>
                                        <ComboBoxItem Content="Single combined file" Tag="SingleCombinedFile"/>
                                    </ComboBox>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="File name template"/>
                                    <TextBox x:Name="TemplateBox" Padding="4,3" Margin="0,0,0,4"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Tokens: {set} {doc} {date} {time} {count}"/>

                                    <CheckBox x:Name="OverwriteCheck" Content="Overwrite existing files"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Selection summary"/>
                                    <TextBlock x:Name="SummaryText" Style="{StaticResource Hint}"
                                               Text="Nothing selected yet."/>
                                    <TextBlock x:Name="EstimateText" TextWrapping="Wrap" Foreground="#FF111827"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ── Options ────────────────────────────────────────────── -->
            <TabItem Header="  Options  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,6,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Coordinates"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Units"/>
                                    <ComboBox x:Name="UnitsCombo">
                                        <ComboBoxItem Content="Meters (glTF standard)" Tag="Meters"/>
                                        <ComboBoxItem Content="Millimeters" Tag="Millimeters"/>
                                        <ComboBoxItem Content="Centimeters" Tag="Centimeters"/>
                                        <ComboBoxItem Content="Feet" Tag="Feet"/>
                                        <ComboBoxItem Content="Inches" Tag="Inches"/>
                                    </ComboBox>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Origin"/>
                                    <ComboBox x:Name="OriginCombo" SelectionChanged="OnOriginChanged">
                                        <ComboBoxItem Content="Recentre on selection (recommended)" Tag="SelectionCenter"/>
                                        <ComboBoxItem Content="Recentre XY, keep elevation" Tag="SelectionCenterKeepElevation"/>
                                        <ComboBoxItem Content="Recentre on whole model" Tag="ModelCenter"/>
                                        <ComboBoxItem Content="Keep world coordinates" Tag="WorldOrigin"/>
                                        <ComboBoxItem Content="Custom point…" Tag="Custom"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Survey coordinates lose centimetre accuracy in 32-bit float. Recentring keeps geometry exact; the offset is recorded in the file so you can georeference it back."/>

                                    <Grid x:Name="CustomOriginPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="OriginXBox" Margin="0,0,4,0" Padding="4,3"/>
                                        <TextBox x:Name="OriginYBox" Grid.Column="1" Margin="0,0,4,0" Padding="4,3"/>
                                        <TextBox x:Name="OriginZBox" Grid.Column="2" Padding="4,3"/>
                                    </Grid>

                                    <CheckBox x:Name="YUpCheck" Content="Convert Z-up to Y-up (glTF convention)"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Geometry"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Structure"/>
                                    <ComboBox x:Name="GroupingCombo">
                                        <ComboBoxItem Content="Merge by material — smallest, fastest" Tag="MergeByMaterial"/>
                                        <ComboBoxItem Content="One node per source file" Tag="PerModelFile"/>
                                        <ComboBoxItem Content="One node per item — keeps names" Tag="PerItem"/>
                                    </ComboBox>

                                    <CheckBox x:Name="WeldCheck" Content="Weld coincident vertices"/>
                                    <StackPanel Orientation="Horizontal" Margin="20,0,0,6">
                                        <TextBlock Text="Tolerance" VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Foreground="{StaticResource Muted}"/>
                                        <TextBox x:Name="WeldToleranceBox" Width="80" Padding="4,3"/>
                                        <TextBlock Text="(target units)" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Foreground="{StaticResource Muted}"/>
                                    </StackPanel>

                                    <CheckBox x:Name="NormalsCheck" Content="Export normals"/>
                                    <CheckBox x:Name="VertexColorsCheck" Content="Export vertex colours"/>
                                    <CheckBox x:Name="LinesCheck" Content="Include line geometry (2D linework)"/>
                                    <CheckBox x:Name="SkipHiddenCheck" Content="Skip items hidden in Navisworks"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Drop triangles smaller than" VerticalAlignment="Center"
                                                   Margin="0,0,6,0" Foreground="{StaticResource Muted}"/>
                                        <TextBox x:Name="MinEdgeBox" Width="80" Padding="4,3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Materials"/>
                                    <CheckBox x:Name="MaterialsCheck" Content="Export materials"/>
                                    <CheckBox x:Name="TransparencyCheck" Content="Preserve transparency"/>
                                    <CheckBox x:Name="DoubleSidedCheck" Content="Double-sided faces"/>
                                    <CheckBox x:Name="ComMaterialsCheck"
                                              Content="Read specular/shininess from the COM appearance"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Colours come from what Navisworks renders, including appearance overrides. The COM path adds gloss but is not available on every fragment."/>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Default roughness" VerticalAlignment="Center"
                                                   Margin="0,0,6,0" Foreground="{StaticResource Muted}"/>
                                        <TextBox x:Name="RoughnessBox" Width="60" Padding="4,3"/>
                                        <TextBlock Text="metallic" VerticalAlignment="Center"
                                                   Margin="12,0,6,0" Foreground="{StaticResource Muted}"/>
                                        <TextBox x:Name="MetallicBox" Width="60" Padding="4,3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Metadata"/>
                                    <CheckBox x:Name="ExtrasCheck" Content="Embed item identity in glTF extras"/>
                                    <CheckBox x:Name="PropertiesCheck" Content="Write a .properties.json sidecar"/>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Property categories (blank = all, semicolon separated)"/>
                                    <TextBox x:Name="PropertyFilterBox" Padding="4,3" Margin="0,0,0,4"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="The sidecar joins back to the model on item GUID, so metadata stays out of the geometry file."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Presets"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="PresetCombo" Margin="0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                            <Button Content="Load" MinWidth="56" Click="OnLoadPreset"/>
                                            <Button Content="Save as…" MinWidth="72" Click="OnSavePreset"/>
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="Reset to defaults" HorizontalAlignment="Left" Click="OnResetDefaults"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ── Log ────────────────────────────────────────────────── -->
            <TabItem Header="  Log  ">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Copy" Click="OnCopyLog"/>
                            <Button Content="Clear" Click="OnClearLog"/>
                            <Button Content="Open output folder" MinWidth="140" Click="OnOpenOutputFolder"/>
                            <CheckBox x:Name="VerboseCheck" Content="Verbose" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11" Background="#FFFAFAFA"
                                 BorderBrush="{StaticResource Line}"/>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
