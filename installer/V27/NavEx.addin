<?xml version="1.0" encoding="utf-8"?>
<!--
  Navisworks add-in manifest.

  Deployed alongside NavEx.dll into:
      C:\Program Files\Autodesk\Navisworks Manage <year>\Plugins\NavEx\

  The plugin appears on the Add-Ins ribbon tab as "NavEx".
-->
<Addin Version="1.0">
  <CompanyName>ACLP_VDC</CompanyName>
  <AddInName>NavEx</AddInName>
  <AddInDescription>NavEx: export search sets and selections as GLB / glTF / OBJ</AddInDescription>
  <AddInVersion>1.0.0.0</AddInVersion>
  <FullClassName>NavEx.PluginMain</FullClassName>
  <AssemblyFile>NavEx.dll</AssemblyFile>
</Addin>